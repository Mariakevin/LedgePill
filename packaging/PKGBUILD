# Maintainer: Marco Zorn <m@zorn.it>
pkgname=ledge-pill
pkgver=1.0.0
pkgrel=1
pkgdesc="A Dynamic Island for your Linux desktop — fluid, native, light on your battery"
arch=('any')
install=ledge-pill.install
url="https://github.com/Mariakevin/LedgePill"
license=('MIT')
depends=('python' 'python-gobject' 'python-cairo' 'gtk4' 'gtk4-layer-shell'
         'libadwaita' 'libpulse')
optdepends=('networkmanager: connectivity tile and peeks'
            'upower: battery ring and charge peeks'
            'alsa-utils: sync hardware microphone mute LEDs'
            'cava: audio-reactive equalizer bars')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$pkgname-$pkgver"

  install -d "$pkgdir/usr/lib/$pkgname"
  cp -r ledgepill "$pkgdir/usr/lib/$pkgname/"

  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/ledge-pill" <<'EOF'
#!/bin/sh
PYTHONPATH=/usr/lib/ledge-pill exec python3 -m ledgepill "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/ledge-pill"

  install -Dm644 data/ledge-pill.desktop \
    "$pkgdir/usr/share/applications/ledge-pill.desktop"
  install -Dm644 data/ledge-pill.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/ledge-pill.svg"
  install -Dm644 data/ledge-pill.service \
    "$pkgdir/usr/lib/systemd/user/ledge-pill.service"
  install -Dm644 data/ledge-pill-mic-led.conf \
    "$pkgdir/usr/lib/modules-load.d/90-ledge-pill-mic-led.conf"
  install -Dm644 data/99-ledge-pill-mic-led.rules \
    "$pkgdir/usr/lib/udev/rules.d/99-ledge-pill-mic-led.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
